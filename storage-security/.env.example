# SIH1284 Storage & Security Environment Variables

# Master Key Encryption Key (KEK) for Envelope Key Management (Must be 64-char Hex / 32-byte)
MASTER_KEK_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Off-Chain Storage Driver Configuration (ipfs | s3 | local)
STORAGE_DRIVER=local

# IPFS Node API Endpoint
IPFS_API_URL=http://127.0.0.1:5001

# AWS S3 Settings (if STORAGE_DRIVER=s3)
S3_BUCKET_NAME=sih1284-encrypted-documents
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key

# Local Storage Path (if STORAGE_DRIVER=local)
LOCAL_STORAGE_DIR=./storage_vault

# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=sih1284_evault
PGSSL=false

# Storage Service API Server Port
STORAGE_SERVICE_PORT=4001
