{
  "name": "sih1284-storage-security",
  "version": "1.0.0",
  "description": "SIH1284 Member 4 Scope: Off-Chain Storage, AES-256 Encryption, Postgres Schema & Key Management",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/**/*.test.js",
    "test:src": "tsx --test src/**/*.test.ts",
    "storage:start": "tsx src/storage/server.ts",
    "db:migrate": "tsx src/db/migrate.ts up",
    "db:migrate:down": "tsx src/db/migrate.ts down"
  },
  "keywords": [
    "sih1284",
    "blockchain",
    "evault",
    "encryption",
    "ipfs",
    "key-management",
    "postgres"
  ],
  "author": "Member 4 - Storage, Security & Database Lead",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
