# ============================================
# eVault Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# Every variable listed here is REQUIRED unless marked [optional].

# ---- Server ----
NODE_ENV=development
PORT=3000

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://evault:your_db_password@localhost:5432/evault_db?schema=public

# ---- JWT ----
JWT_SECRET=your_strong_jwt_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- CORS ----
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# ---- Rate Limiting ----
# Max requests per window (general)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Stricter rate limit for auth routes
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ---- File Upload ----
# Max file size in bytes (25MB default)
MAX_FILE_SIZE=26214400

# ---- Logging ----
LOG_LEVEL=debug

# ---- Blockchain ----
# Set to 'true' for local dev (in-memory mock, no Fabric network needed)
# Set to 'false' when the real Hyperledger Fabric network is running (e.g. in WSL2)
USE_BLOCKCHAIN_MOCK=true
